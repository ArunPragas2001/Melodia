{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "jsx": "react-native",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "App.js",
    "index.js",
    "src/**/*.js",
    "types/**/*.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
